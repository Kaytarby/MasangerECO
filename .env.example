# === Для Vercel + Supabase (продакшен) ===
# URL проекта Supabase (Project Settings → API → Project URL)
# SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# Сервисный ключ Supabase (Project Settings → API → service_role / secret key)
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Секрет для подписи JWT-токенов (любая длинная случайная строка)
# JWT_SECRET="change-me-to-a-long-random-string"

# === Только для локального запуска / Docker (SQLite) ===
# PORT=3000
# DB_PATH="eco_culture.db"
# UPLOADS_DIR="uploads"
